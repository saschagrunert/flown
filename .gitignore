# The flights are committed in data/ and its subdirectories (doc/usage.md
# shows data/2025/ as an example), or in flights/, where doc/hosting.md has
# a copy of the repository keep its own; every other KML file stays local,
# whatever the case of its extension (the generator reads any), and every
# KMZ archive, which the obfuscation check cannot read into
*.[kK][mM][lLzZ]
!/data/**/*.[kK][mM][lL]
!/flights/**/*.[kK][mM][lL]
# The flights the visual snapshots are taken with (scripts/build_visual_site.py)
!/tests/fixtures/visual/*.[kK][mM][lL]
# Temp files of an interrupted obfuscation run hold the original dates
data/**/.*.tmp
AGENTS.md
.playwright-mcp

# Generated sites, never committed: docs/ is the default OUTPUT_DIR of
# `make build`, out/ the output of the examples in doc/usage.md, site/ the
# one the deploy job publishes, e2e-sites/ the two the e2e jobs test and
# visual-site/ the one the visual snapshots are compared against.
/docs/
/out/
/site/
/e2e-sites/
/visual-site/

# Python
__pycache__
*.pyc
*.egg-info/
.venv/
venv/
.mypy_cache
.ruff_cache
.pytest_cache/
.hypothesis/
# setuptools' output of a wheel build, at the root only: eslint.config.js
# reads these patterns too, and a directory of the sources with one of these
# names would go unlinted
/dist/
/build/

# Node
node_modules

# Test coverage reports
.coverage
.coverage.*
/coverage.xml
/coverage/
/htmlcov/

# Playwright test results
test-results*/
playwright-report*/

# Test data
kml_test_*

# JavaScript build artifacts (generated by esbuild from flown/frontend/)
flown/static/*.bundle.js
flown/static/*.map
# The metafile of `node build.js --metafile` (see scripts/README.md)
/bundle-meta.json
# Third-party files copied out of node_modules by scripts/vendor.js
flown/static/vendor/
flown/static/flags/
.claude/
